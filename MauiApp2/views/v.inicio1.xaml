<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp2.views.v.inicio1"
             Title="Restaurante L'Étoile"
             BackgroundColor="#121212">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="GoldCardStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="#1E1E1E" />
                <Setter Property="Stroke" Value="#D4AF37" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="DarkCardStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="#1A1A1A" />
                <Setter Property="StrokeShape" Value="RoundRectangle 10" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="15" />
            </Style>

            <Style x:Key="GoldTitleStyle" TargetType="Label">
                <Setter Property="TextColor" Value="#D4AF37" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="SubTitleStyle" TargetType="Label">
                <Setter Property="TextColor" Value="#E0E0E0" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *" Margin="10">

        <!-- Banner de Notificación Integrado (Toast Flotante) -->
        <Border x:Name="NotificationBanner" Grid.Row="0" BackgroundColor="#2A2415" Stroke="#D4AF37" StrokeThickness="1"
                Padding="12,8" HorizontalOptions="Center" VerticalOptions="Start" IsVisible="False" Margin="0,0,0,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <HorizontalStackLayout Spacing="10">
                <Label Text="✓" TextColor="#D4AF37" FontAttributes="Bold" VerticalOptions="Center" />
                <Label x:Name="LblNotificationText" Text="Platillo agregado correctamente" TextColor="White" FontSize="13" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>

        <!-- Layout Principal -->
        <Grid Grid.Row="1" ColumnDefinitions="220, *, 280" ColumnSpacing="15">

            <!-- 1. MENÚ LATERAL IZQUIERDO -->
            <VerticalStackLayout Grid.Column="0" Spacing="8">
                <Label Text="L'ÉTOILE" TextColor="#D4AF37" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center" />
                <Label Text="CUISINE GASTRONOMIQUE" TextColor="#888888" FontSize="9" HorizontalOptions="Center" Margin="0,-5,0,20" />

                <Button x:Name="BtnInicio" Text=" Inicio / Bienvenida" BackgroundColor="#2A2415" TextColor="#D4AF37" CornerRadius="8" HorizontalOptions="Fill" Clicked="OnNavClicked" />
                <Button x:Name="BtnMenu" Text=" Menú Gourmet" BackgroundColor="Transparent" TextColor="#CCCCCC" HorizontalOptions="Fill" Clicked="OnNavClicked" />
                <Button x:Name="BtnReservas" Text=" Reservaciones" BackgroundColor="Transparent" TextColor="#CCCCCC" HorizontalOptions="Fill" Clicked="OnNavClicked" />
                <Button x:Name="BtnCava" Text=" Cava de Vinos" BackgroundColor="Transparent" TextColor="#CCCCCC" HorizontalOptions="Fill" Clicked="OnNavClicked" />
                <Button x:Name="BtnContacto" Text=" Contacto &amp; Ubicación" BackgroundColor="Transparent" TextColor="#CCCCCC" HorizontalOptions="Fill" Clicked="OnNavClicked" />
            </VerticalStackLayout>

            <!-- 2. PANEL CENTRAL (CATÁLOGO / CONTENIDO) -->
            <ScrollView Grid.Column="1">
                <VerticalStackLayout Spacing="15">

                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="LblSeccionTitulo" Text="Una Experiencia Culinaria Inolvidable" FontSize="24" FontAttributes="Bold" TextColor="White" />
                        <Label x:Name="LblSeccionSubtitulo" Text="Seleccione sus platillos para armar su orden en tiempo real." FontSize="13" TextColor="#AAAAAA" />
                    </VerticalStackLayout>

                    <!-- Formulario de Reserva Integrado en Pantalla -->
                    <Border Style="{StaticResource GoldCardStyle}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="RESERVA TU MESA VIP" Style="{StaticResource GoldTitleStyle}" />

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                <Picker x:Name="PckPersonas" Title="Comensales" TitleColor="#888888" TextColor="White" BackgroundColor="#151515" Grid.Column="0">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>2 Personas</x:String>
                                            <x:String>4 Personas</x:String>
                                            <x:String>6+ Personas (Mesa VIP)</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>

                                <Picker x:Name="PckHorario" Title="Horario" TitleColor="#888888" TextColor="White" BackgroundColor="#151515" Grid.Column="1">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>14:00 PM - Almuerzo</x:String>
                                            <x:String>20:00 PM - Cena Gourmet</x:String>
                                            <x:String>22:00 PM - Velada VIP</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Grid>

                            <Button Text="Confirmar Reserva Directa" BackgroundColor="#D4AF37" TextColor="#121212" FontAttributes="Bold" CornerRadius="6" Clicked="OnConfirmarReservaDirecta" HeightRequest="38" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Especialidades -->
                    <Label Text="Especialidades de la Casa" Style="{StaticResource SubTitleStyle}" />

                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="10" RowSpacing="10">
                        <!-- Plato 1 -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DarkCardStyle}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Filet Mignon al Malbec" TextColor="#D4AF37" FontSize="15" FontAttributes="Bold" />
                                <Label Text="Corte tierno de res en reducción de vino tinto y trufa negra." TextColor="#888888" FontSize="11" />
                                <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,0">
                                    <Label Grid.Column="0" Text="$48.00" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="+ Agregar" BackgroundColor="#252525" TextColor="#D4AF37" CornerRadius="4" HeightRequest="30" FontSize="11" Clicked="OnAgregarPlato1" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Plato 2 -->
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkCardStyle}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Langosta a la Mantequilla" TextColor="#D4AF37" FontSize="15" FontAttributes="Bold" />
                                <Label Text="Cola de langosta caribeña horneada con mantequilla clarificada." TextColor="#888888" FontSize="11" />
                                <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,0">
                                    <Label Grid.Column="0" Text="$62.00" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="+ Agregar" BackgroundColor="#252525" TextColor="#D4AF37" CornerRadius="4" HeightRequest="30" FontSize="11" Clicked="OnAgregarPlato2" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Plato 3 -->
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DarkCardStyle}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Vino Chateau Margaux" TextColor="#D4AF37" FontSize="15" FontAttributes="Bold" />
                                <Label Text="Gran vino tinto de Burdeos con notas de fruta madura." TextColor="#888888" FontSize="11" />
                                <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,0">
                                    <Label Grid.Column="0" Text="$120.00" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="+ Agregar" BackgroundColor="#252525" TextColor="#D4AF37" CornerRadius="4" HeightRequest="30" FontSize="11" Clicked="OnAgregarPlato3" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Plato 4 -->
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DarkCardStyle}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Souflé de Chocolate" TextColor="#D4AF37" FontSize="15" FontAttributes="Bold" />
                                <Label Text="Postre tibio con corazón fluido de cacao al 70%." TextColor="#888888" FontSize="11" />
                                <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,0">
                                    <Label Grid.Column="0" Text="$22.00" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="+ Agregar" BackgroundColor="#252525" TextColor="#D4AF37" CornerRadius="4" HeightRequest="30" FontSize="11" Clicked="OnAgregarPlato4" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                </VerticalStackLayout>
            </ScrollView>

            <!-- 3. PANEL DERECHO: PANEL DE DETALLE DE LA ORDEN EN TIEMPO REAL -->
            <Border Grid.Column="2" Style="{StaticResource DarkCardStyle}">
                <Grid RowDefinitions="Auto, *, Auto" RowSpacing="10">
                    <VerticalStackLayout Grid.Row="0" Spacing="2">
                        <Label Text="MI PEDIDO EN VIVO" TextColor="#D4AF37" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                        <BoxView HeightRequest="1" Color="#333333" Margin="0,5" />
                    </VerticalStackLayout>

                    <!-- Lista viva de elementos -->
                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout x:Name="ContainerItems" Spacing="8">
                            <Label x:Name="LblEmptyCart" Text="El carrito está vacío.\nAgregue platillos desde el menú." TextColor="#666666" FontSize="12" HorizontalTextAlignment="Center" Margin="0,30,0,0" />
                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Totales y Acción Directa -->
                    <VerticalStackLayout Grid.Row="2" Spacing="8">
                        <BoxView HeightRequest="1" Color="#333333" />
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Total a Pagar:" TextColor="White" FontAttributes="Bold" FontSize="14" />
                            <Label x:Name="LblTotal" Grid.Column="1" Text="$0.00" TextColor="#D4AF37" FontAttributes="Bold" FontSize="16" />
                        </Grid>

                        <Button Text="Enviar Orden a Cocina" BackgroundColor="#D4AF37" TextColor="#121212" FontAttributes="Bold" CornerRadius="6" Clicked="OnEnviarCocinaClicked" HeightRequest="38" />
                        <Button Text="Limpiar Todo" BackgroundColor="Transparent" TextColor="#FF6B6B" FontSize="11" Clicked="OnLimpiarClicked" HeightRequest="25" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

        </Grid>
    </Grid>

</ContentPage>